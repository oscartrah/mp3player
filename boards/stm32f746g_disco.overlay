/* boards/stm32f746g_disco.overlay */
#include <zephyr/dt-bindings/display/panel.h>

/* ── SAI1 Block A: PE2=MCLK, PE5=SCK, PE6=SD, PE4=FS ─────── */
&sai1_a {
    dma-names = "tx";
    pinctrl-0 = <&sai1_mclk_a_pe2 &sai1_sck_a_pe5
                 &sai1_sd_a_pe6   &sai1_fs_a_pe4>;
    pinctrl-names = "default";
    status = "okay";
};

/* ── DMA2: required for st_stm32_dma_v1 SAI driver ────────── */
&dma2 {
    status = "okay";
};

/* ── RNG for sys_rand_get ─────────────────────────────────── */
&rng {
    status = "okay";
};

/* ── WM8994 on I2C3 (PH7=SCL, PH8=SDA) ──────────────────── */
&i2c3 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    wm8994: wm8994@1b {
        compatible = "wolfson,wm8994";
        reg = <0x1b>;
    };

    ft5336@38 {
        compatible = "focaltech,ft5336";
        reg = <0x38>;
        int-gpios = <&gpioi 13 GPIO_ACTIVE_LOW>;
    };
};

/* ── SDMMC1 (SD card) ─────────────────────────────────────── */
&sdmmc1 {
    status = "okay";
    pinctrl-0 = <&sdmmc1_d0_pc8 &sdmmc1_d1_pc9
                 &sdmmc1_d2_pc10 &sdmmc1_d3_pc11
                 &sdmmc1_ck_pc12 &sdmmc1_cmd_pd2>;
    pinctrl-names = "default";
    cd-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>;
    bus-width = <4>;

    mmc {
        compatible = "zephyr,sdmmc-disk";
        disk-name  = "SD";
        status     = "okay";
    };
};

/* ── LTDC (480×272 RK043FN02H parallel panel) ─────────────── */
&ltdc {
    status = "okay";
    ext-sdram = <&sdram1>;
    width     = <480>;
    height    = <272>;
    pixel-format = <PANEL_PIXEL_FORMAT_RGB_888>;
    disp-on-gpios = <&gpioi 12 GPIO_ACTIVE_HIGH>;
    bl-ctrl-gpios = <&gpiok 3  GPIO_ACTIVE_HIGH>;

    display-timings {
        compatible = "zephyr,panel-timing";
        hsync-active   = <0>;
        vsync-active   = <0>;
        de-active      = <1>;
        pixelclk-active = <0>;
        hsync-len      = <41>;
        vsync-len      = <10>;
        hback-porch    = <8>;
        vback-porch    = <2>;
        hfront-porch   = <4>;
        vfront-porch   = <4>;
    };
};

/* ── Flash partitions for NVS ─────────────────────────────── */
&flash0 {
    partitions {
        compatible    = "fixed-partitions";
        #address-cells = <1>;
        #size-cells    = <1>;

        slot0_partition: partition@0 {
            label = "image-0";
            reg   = <0x00000000 0x000F0000>;
        };
        nvs_storage: partition@F0000 {
            label = "nvs_storage";
            reg   = <0x000F0000 0x00010000>;
        };
    };
};
