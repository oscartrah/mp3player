/* boards/mimxrt1060_evk.overlay */
#include <zephyr/dt-bindings/display/panel.h>

/ {
    chosen {
        zephyr,display = &lcdif;
    };
};

/* ── SAI1: WM8960 audio ───────────────────────────────────── */
&sai1 {
    status = "okay";
    mclk-output;
};

/* ── LPI2C1: WM8960 codec + FT5336 touch ─────────────────── */
&lpi2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;

    wm8960: wm8960@1a {
        compatible = "wolfson,wm8960";
        reg = <0x1a>;
    };

    ft5336@38 {
        compatible = "focaltech,ft5336";
        reg = <0x38>;
        int-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
    };
};

/* ── USDHC1: SD card ──────────────────────────────────────── */
&usdhc1 {
    status = "okay";
    no-1-8-v;

    mmc {
        compatible = "zephyr,sdmmc-disk";
        disk-name  = "SD";
        status     = "okay";
    };
};

/* ── eLCDIF: 480×272 RK043FN02H parallel panel ────────────── */
&lcdif {
    status = "okay";
    width  = <480>;
    height = <272>;
    pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;

    display-timings {
        compatible = "zephyr,panel-timing";
        clock-frequency = <9210240>;
        hsync-active   = <0>;
        vsync-active   = <0>;
        de-active      = <1>;
        pixelclk-active = <0>;
        hsync-len      = <41>;
        vsync-len      = <10>;
        hback-porch    = <8>;
        vback-porch    = <2>;
        hfront-porch   = <4>;
        vfront-porch   = <4>;
    };
};
