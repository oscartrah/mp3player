choice AUDIO_HAL_BACKEND
    prompt "Audio Codec Backend"
    default AUDIO_HAL_WM8994

config AUDIO_HAL_WM8994
    bool "WM8994 (STM32F769I-DISCO / STM32F746G-DISCO)"
    help
      Wolfson WM8994 Audio Hub, 5-Band HW-EQ, HW-DRC.

config AUDIO_HAL_WM8960
    bool "WM8960 (i.MX RT1060 EVK)"
    help
      Wolfson WM8960 — kein HW-EQ, SW-Biquad Fallback.

config AUDIO_HAL_WM8904
    bool "WM8904 (LPCXpresso54628)"
    help
      Wolfson WM8904, 5-Band HW-EQ, HW-DRC.

config AUDIO_HAL_DA7212
    bool "DA7212 (EK-RA6M3G)"
    help
      Dialog DA7212, 5-Band HW-EQ.

endchoice

config AUDIO_HAL_SW_EQ_FALLBACK
    bool "Software Biquad EQ Fallback"
    default y if AUDIO_HAL_WM8960
    help
      Aktiviert Software-EQ für Codecs ohne Hardware-EQ.
